---
// The live "quote-request" Netlify form, field for field (names, values and order unchanged). Added for SITE_RULES 2.9:
// the /thank-you action and a hidden "page" field (filled by main.js with the path and any utm_ tags).
// main.js opens it step by step (name + phone first); without JS every step shows.
---

<form class="quote-form" name="quote-request" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="quote-request">
  <input type="hidden" name="page" value="/">
  <p class="quote-form-honeypot" aria-hidden="true">
    <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1"></label>
  </p>
  <div class="qf-step" data-step="1">
    <div class="quote-form-row">
      <div class="quote-form-field">
        <label for="qf-name">Full Name *</label>
        <input type="text" id="qf-name" name="name" placeholder="Full Name" autocomplete="name" required>
      </div>
      <div class="quote-form-field">
        <label for="qf-phone">Phone *</label>
        <input type="tel" id="qf-phone" name="phone" placeholder="Phone" autocomplete="tel" required>
      </div>
    </div>
    <!-- SMS consent for Rock Solid Tile's 10DLC campaign: unchecked, optional, separate from any terms, names the business and the message types, links to the policy pages. -->
    <label class="quote-form-consent" for="qf-sms-consent">
      <input type="checkbox" id="qf-sms-consent" name="sms_consent" value="yes">
      <span>By providing my phone number and checking this box, I agree to receive SMS customer care messages from Rock Solid Tile: callback confirmations, follow-ups on my request, appointment reminders and a review request after a completed job. Message frequency may vary. Standard message and data rates may apply. Reply STOP to opt out, HELP for help. We will not share mobile information with third parties for promotional or marketing purposes. Consent is not a condition of purchase. <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms</a>.</span>
    </label>
  </div>
  <div class="qf-step" data-step="2">
    <div class="quote-form-row">
      <div class="quote-form-field">
        <label for="qf-email">Email *</label>
        <input type="email" id="qf-email" name="email" placeholder="Email" autocomplete="email" required>
      </div>
      <div class="quote-form-field">
        <label for="qf-zip">Zip Code</label>
        <input type="text" id="qf-zip" name="zip" placeholder="Zip Code" inputmode="numeric" autocomplete="postal-code">
      </div>
    </div>
  </div>
  <div class="qf-step" data-step="3">
    <fieldset class="quote-form-group" style="border:0;padding:0;margin:0 0 18px">
      <legend class="quote-form-label">Select a Service *</legend>
      <div class="quote-form-options">
        <label class="quote-form-option"><input type="checkbox" name="service[]" value="Bathroom Tile Installation"> Bathroom Tile Installation</label>
        <label class="quote-form-option"><input type="checkbox" name="service[]" value="Shower Tile Installation"> Shower Tile Installation</label>
        <label class="quote-form-option"><input type="checkbox" name="service[]" value="Kitchen Tile &amp; Backsplash"> Kitchen Tile &amp; Backsplash</label>
        <label class="quote-form-option"><input type="checkbox" name="service[]" value="Floor Tile Installation"> Floor Tile Installation</label>
        <label class="quote-form-option"><input type="checkbox" name="service[]" value="Patio &amp; Lanai Tile"> Patio &amp; Lanai Tile</label>
        <label class="quote-form-option"><input type="checkbox" name="service[]" value="Other"> Other</label>
      </div>
    </fieldset>
  </div>
  <div class="qf-step" data-step="4">
    <fieldset class="quote-form-group" style="border:0;padding:0;margin:0 0 18px">
      <legend class="quote-form-label">When Would You Like This Completed?</legend>
      <div class="quote-form-options">
        <label class="quote-form-option"><input type="radio" name="timing" value="Timing is flexible"> Timing is flexible</label>
        <label class="quote-form-option"><input type="radio" name="timing" value="Less than 2 months"> Less than 2 months</label>
        <label class="quote-form-option"><input type="radio" name="timing" value="More than 2 months"> More than 2 months</label>
      </div>
    </fieldset>
    <fieldset class="quote-form-group" style="border:0;padding:0;margin:0 0 18px">
      <legend class="quote-form-label">Choose The Appropriate Status For This Project</legend>
      <div class="quote-form-options">
        <label class="quote-form-option"><input type="radio" name="status" value="Ready to hire"> Ready to hire</label>
        <label class="quote-form-option"><input type="radio" name="status" value="Planning &amp; budgeting"> Planning &amp; budgeting</label>
      </div>
    </fieldset>
    <div class="quote-form-field">
      <label for="qf-details">Tell Us A Little About Your Project</label>
      <textarea id="qf-details" name="details" placeholder="Write here..."></textarea>
    </div>
    <button type="submit" class="btn btn-umber btn-block">Submit</button>
  </div>
</form>
