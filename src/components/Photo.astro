---
// A job photo as <picture>: WebP 800w + full-size srcset, real width/height, and an optional "skip" media query.
// skip="phone" serves a 1x1 placeholder below 761 px (the frame is hidden there, so nothing is downloaded);
// skip="desktop" does the same from 761 px up (the phone-only float). SITE_RULES 4.9, 7.7, 10.12.
import { imageInfo, webpSrcset } from '../lib/images';

interface Props { src: string; alt: string; sizes?: string; eager?: boolean; skip?: 'phone' | 'desktop'; class?: string }
const { src, alt, sizes = '(max-width: 760px) 100vw, 50vw', eager = false, skip, class: className } = Astro.props;
const info = await imageInfo(src);
if (!info) throw new Error(`Photo not found: ${src}`);
const srcset = webpSrcset(info);
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const media = skip === 'phone' ? '(max-width: 760px)' : skip === 'desktop' ? '(min-width: 761px)' : undefined;
---

<picture>
  {media && <source media={media} srcset={BLANK} />}
  {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
  <img src={src} alt={alt} width={info.width} height={info.height} class={className} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} />
</picture>
