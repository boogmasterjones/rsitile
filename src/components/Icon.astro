---
// Small line icons used across the site (inline, so there is no sprite request).
interface Props { name: 'phone' | 'arrow' | 'chev' | 'mail' | 'pin'; size?: number }
const { name, size = 20 } = Astro.props;
const paths: Record<Props['name'], string> = {
  phone: '<path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11 11 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.6 16.6 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z"/>',
  arrow: '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 12h15m-6-6 6 6-6 6"/>',
  chev: '<path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.9"/><path fill="none" stroke="currentColor" stroke-width="1.9" d="m3 7 9 6 9-6"/>',
  pin: '<path fill="none" stroke="currentColor" stroke-width="1.9" d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="1.9"/>',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]} />
