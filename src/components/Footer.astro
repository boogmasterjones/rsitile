---
// Footer with its own closing CTA panel, so a page never ends on a plain section (SITE_RULES 2.1).
// Column titles are not headings (SITE_RULES 8.8).
import Icon from './Icon.astro';
import { navLinks } from '../lib/nav';
import { phoneHref, site } from '../lib/site';

interface Props { home?: boolean; cta?: boolean }
const { home = false, cta = true } = Astro.props;
const { services, areas } = await navLinks();
const tel = phoneHref(site.business.phone);
const quote = home ? '#contact' : '/#contact';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    {cta && (
      <div class="foot-cta">
        <div>
          <p class="big">Ready to start your tile project?</p>
          <p>Free in-home estimates with a written quote, across {site.business.regionLabel}.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-call" href={tel} data-cta="footer_cta"><Icon name="phone" />Call {site.business.phone}</a>
          <a class="btn btn-ghost" href={quote}>Get a Free Estimate</a>
        </div>
      </div>
    )}
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/" aria-label={`${site.business.name}, home`}>
          <span class="mark" aria-hidden="true"></span>
          <span><span class="brand-name">{site.brand.logoText}</span><span class="brand-sub">{site.business.regionLabel}</span></span>
        </a>
        <p>Locally owned, licensed &amp; insured tile contractor serving Southwest Florida for over 30 years.</p>
      </div>
      <nav aria-labelledby="ft-services">
        <p class="foot-title" id="ft-services">Services</p>
        <ul>{services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="ft-areas">
        <p class="foot-title" id="ft-areas">Service Areas</p>
        <ul>{areas.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <p class="foot-title">Contact</p>
        <ul class="foot-contact">
          <li><Icon name="phone" size={18} /><a class="tel" href={tel} data-cta="footer">{site.business.phone}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${site.business.email}`}>{site.business.email}</a></li>
          <li><Icon name="pin" size={18} /><span>{site.business.regionLabel}</span></li>
        </ul>
        <nav aria-label="More links">
          <ul>
            <li><a href="/schedule">Schedule a Call</a></li>
            <li><a href="/blog">Blog</a></li>
          </ul>
        </nav>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {site.business.name}. All rights reserved. Licensed &amp; Insured. <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
      <span>Serving Southwest Florida — Sarasota, Venice, North Port, Port Charlotte, Punta Gorda, Cape Coral, Bradenton &amp; more</span>
    </div>
  </div>
</footer>
