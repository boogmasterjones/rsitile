---
// Espresso header: the RSI "I" mark and wordmark, the menu (services and areas as drop-downs), and the phone,
// always visible and tap-to-call (SITE_RULES 2.4). It sits over the dark hero and slides back in, compact, once
// the visitor scrolls (public/js/main.js).
import Icon from './Icon.astro';
import { navLinks } from '../lib/nav';
import { phoneHref, site } from '../lib/site';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const { services, areas } = await navLinks();
const tel = phoneHref(site.business.phone);
const here = (id: string) => (home ? `#${id}` : `/#${id}`);
---

<header class="site-head" data-head>
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.business.name}, home`}>
      <span class="mark" aria-hidden="true"></span>
      <span><span class="brand-name">{site.brand.logoText}</span><span class="brand-sub">Tile installation · {site.business.regionLabel}</span></span>
    </a>
    <nav class="nav" id="main-nav" aria-label="Main">
      <div class="nav-drop">
        <button type="button" aria-expanded="false" aria-controls="drop-services">Services <Icon name="chev" size={12} /></button>
        <div class="drop" id="drop-services">{services.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      </div>
      <div class="nav-drop">
        <button type="button" aria-expanded="false" aria-controls="drop-areas">Service Areas <Icon name="chev" size={12} /></button>
        <div class="drop" id="drop-areas">{areas.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      </div>
      <a href={here('our-work')}>Our Work</a>
      <a href={here('reviews')}>Reviews</a>
      <a href="/blog">Blog</a>
      <a href="/schedule">Schedule a Call</a>
      <a href={here('contact')}>Free Estimate</a>
    </nav>
    <div class="head-call">
      <a class="num" href={tel} data-cta="header">{site.business.phone}</a>
      <a class="btn-sq" href={tel} data-cta="header_button" aria-label={`Call ${site.business.name} at ${site.business.phone}`}><Icon name="phone" size={21} /></a>
      <button class="btn-sq menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open the menu"><span></span></button>
    </div>
  </div>
</header>
