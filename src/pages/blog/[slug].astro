---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { formatDate, getPosts, readingTime } from '../../lib/content';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { site } from '../../lib/site';
import { emHtml } from '../../lib/text';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const author = data.author ?? site.business.name;
const date = formatDate(data.date);
const minutes = readingTime(post.body ?? '');
const jsonLd = [blogPostingSchema({ ...data, path }), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: data.title, path }]), ...(data.faqs.length > 0 ? [faqSchema(data.faqs)] : [])];
---

<Base title={`${data.title} | ${site.brand.logoText}`} description={data.description} image={data.image} ogType="article" jsonLd={jsonLd}>
  <section class="hero page-hero">
    <div class="container">
      <div class="page-hero-inner">
        {data.category && <span class="hero-eyebrow">{data.category}</span>}
        <h1 set:html={emHtml(data.title)} />
        <p class="hero-lede">{data.description}</p>
        <p class="last-updated">{data.updatedAt ? 'Last updated: ' + formatDate(data.updatedAt) : 'Published ' + date} &middot; {minutes}</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="content-block">
      {data.image && <Picture src={data.image} alt={data.imageAlt ?? ''} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 760px" />}
      <Content />
      {data.faqs.length > 0 && (
        <>
          <h2>Frequently Asked Questions</h2>
          <div class="section-head"><span class="eyebrow">FAQ</span><h2 id="faq">Frequently Asked Questions</h2></div><div class="faq-list">{data.faqs.map((f) => (<details class="faq-item"><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
        </>
      )}
      </div>
    </div>
  </section>

</Base>
