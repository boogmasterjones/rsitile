---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import Reviews from '../../components/Reviews.astro';
import { formatDate, getPosts, readingTime } from '../../lib/content';
import { displayPhoto } from '../../lib/legacy-photos';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { phoneHref, site } from '../../lib/site';
import { emHtml } from '../../lib/text';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
await render(post);
const path = `/blog/${post.id}`;
const date = formatDate(data.date);
const minutes = readingTime(post.body ?? '');
const jsonLd = [blogPostingSchema({ ...data, path }), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: data.title, path }]), ...(data.faqs.length > 0 ? [faqSchema(data.faqs)] : [])];
const tel = phoneHref(site.business.phone);
const photo = displayPhoto(data.image);

// One CTA row mid-article, before the middle H2 (SITE_RULES 2.2); the end of the article has the closing band.
const html = post.rendered?.html ?? '';
const h2s = [...html.matchAll(/<h2[\s>]/g)].map((m) => m.index ?? 0);
const cut = h2s.length >= 2 ? h2s[Math.floor(h2s.length / 2)] : -1;
const first = cut > 0 ? html.slice(0, cut) : html;
const second = cut > 0 ? html.slice(cut) : '';
---

<Base title={`${data.title} | ${site.brand.logoText}`} description={data.description} image={data.image} ogType="article" jsonLd={jsonLd}>
  <section class="hero page-hero post-hero">
    <div class="amb" aria-hidden="true"><i class="veins"></i><i class="sweep"></i></div>
    <div class="container">
      <div class="page-hero-inner">
        {data.category && <span class="hero-eyebrow">{data.category}</span>}
        <h1 set:html={emHtml(data.title)} />
        <p class="hero-lede">{data.description}</p>
        <p class="last-updated post-meta"><span>{data.updatedAt ? 'Last updated: ' + formatDate(data.updatedAt) : 'Published ' + date}</span><span>{minutes}</span><span>By {data.author ?? site.business.name}</span></p>
        <div class="hero-actions">
          <a class="btn btn-gold" href={tel} data-cta="post_hero"><Icon name="phone" />Call {site.business.phone}</a>
          <a class="btn btn-outline" href="/schedule">Or Schedule A Later Call</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="post-wrap">
        <article class="prose">
          {photo && <Picture src={photo} alt={data.imageAlt ?? ''} class="post-photo" sizes="(max-width: 1180px) 100vw, 760px" />}
          <Fragment set:html={first} />
          {second && (
            <div class="mid-cta">
              <p>Planning a project like this?</p>
              <a class="btn btn-umber" href={tel} data-cta="post_mid"><Icon name="phone" />Call {site.business.phone}</a>
              <a class="btn btn-line" href="/#contact">Get a Free Estimate</a>
            </div>
          )}
          <Fragment set:html={second} />
          {data.faqs.length > 0 && (
            <>
              <h2 id="faq">Frequently Asked Questions</h2>
              <div class="faq-list">{data.faqs.map((f) => (<details class="faq-item"><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
            </>
          )}
        </article>
        <aside class="post-aside" aria-label="Free estimate">
          <div class="aside-card">
            <span class="label" style="color:var(--on-dark)">Free estimate</span>
            <p class="h2like" style="font:400 28px/1.1 var(--head);color:var(--ivory);margin:10px 0 10px">Talk to a local tile crew.</p>
            <p>Family-owned, licensed &amp; insured, 30+ years across Southwest Florida. Every estimate comes with a written quote.</p>
            <a class="btn btn-call" href={tel} data-cta="post_aside"><Icon name="phone" />Call {site.business.phone}</a>
            <a class="btn btn-ghost" href="/#contact">Get a Free Estimate</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <section class="cta-band">
    <div class="container">
      <h2>Ready to Start Your Tile Project?</h2>
      <p>Get a free, no-obligation estimate from a licensed Southwest Florida tile contractor.</p>
      <div class="cta-actions">
        <a class="btn btn-gold" href={tel} data-cta="post_end">Call {site.business.phone}</a>
        <a class="btn btn-outline" href="/schedule">Or Schedule A Later Call</a>
      </div>
    </div>
  </section>
  <Reviews variant="compact" ids={['jill', 'janet', 'taylor']} heading="What Southwest Florida Homeowners Are Saying" />
</Base>
