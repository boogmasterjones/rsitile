# Netlify headers file — controls caching for static assets.
# Hashed/versioned assets could use "immutable"; these filenames are stable but
# can change in place, so we cache long with revalidation allowed.

# Images — cache 1 year (they rarely change; if one does, its filename/content
# changes trigger a fresh fetch on deploy).
/assets/*
  Cache-Control: public, max-age=31536000

# CSS & JS — cache 1 week, allow revalidation.
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800

# Icons
/favicon.svg
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# HTML — always revalidate so content edits show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
